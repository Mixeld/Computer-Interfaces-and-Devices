{
    "version": "2.0.0",
    "tasks": [
        {
    "label": "Compile",
    "type": "shell",
    "command": "C:/msys64/mingw64/bin/g++.exe",
    "args": [
        "-std=c++11",
        "-D_WIN32_WINNT=0x0600",
        "-DNTDDI_VERSION=0x06000000",
        "main.cpp",
        "-o",
        "main.exe",
        "-lpowrprof",
        "-lgdi32",
        "-luser32",
        "-lshell32"
    ],
    "group": {
        "kind": "build",
        "isDefault": true
    },
    "problemMatcher": ["$gcc"],
    "options": {
        "cwd": "${workspaceFolder}"
    }
},
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32",
                "-luser32",
                "-lshell32",
                "-lpowrprof"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}